generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MetalType {
  GOLD
  SILVER
}

enum PricingMode {
  DYNAMIC
  FIXED
}

model Category {
  id        String    @id @default(dbgenerated("gen_random_uuid()::text"))
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id                  String      @id @default(dbgenerated("gen_random_uuid()::text"))
  sku                 String      @unique
  name                String
  slug                String      @unique
  description         String?
  metal               MetalType
  karat               Int?
  grossWeightGrams    Decimal     @db.Decimal(12, 4)
  netMetalWeightGrams Decimal     @db.Decimal(12, 4)
  makingCharge        Decimal     @default(0) @db.Decimal(14, 2)
  stoneCharge         Decimal     @default(0) @db.Decimal(14, 2)
  pricingMode         PricingMode @default(DYNAMIC)
  fixedPrice          Decimal?    @db.Decimal(14, 2)
  stockQuantity       Int         @default(0)
  published           Boolean     @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([metal, published])
  @@index([categoryId])
}

model MetalRate {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  metal        MetalType
  karat        Int
  pricePerTola Decimal   @db.Decimal(14, 2)
  updatedAt    DateTime  @updatedAt

  @@unique([metal, karat])
}

model MetalRateHistory {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  metal           MetalType
  karat           Int
  oldPricePerTola Decimal?  @db.Decimal(14, 2)
  newPricePerTola Decimal   @db.Decimal(14, 2)
  changedBy       String
  changedAt       DateTime  @default(now())

  @@index([metal, karat, changedAt])
}
